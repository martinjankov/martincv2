{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"link": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Primary", "slug": "primary", "color": "#0059b3" },
				{ "name": "Accent", "slug": "accent", "color": "#003d80" },
				{ "name": "Foreground", "slug": "foreground", "color": "#1d2531" },
				{ "name": "Muted Foreground", "slug": "muted-foreground", "color": "#36648c" },
				{ "name": "Muted", "slug": "muted", "color": "#dde6ee" },
				{ "name": "Background", "slug": "background", "color": "#f7f9fb" },
				{ "name": "Border", "slug": "border", "color": "#e3e8ee" },
				{ "name": "Card", "slug": "card", "color": "#ffffff" },
				{ "name": "White", "slug": "white", "color": "#ffffff" }
			],
			"gradients": [
				{
					"name": "Hero",
					"slug": "hero",
					"gradient": "linear-gradient(135deg, hsl(210 100% 30%), hsl(210 100% 40%))"
				},
				{
					"name": "Subtle",
					"slug": "subtle",
					"gradient": "linear-gradient(180deg, hsl(210 40% 95%), hsl(210 30% 92%))"
				}
			],
			"duotone": [
				{
					"colors": ["#000000", "#ffffff"],
					"slug": "default",
					"name": "Default"
				}
			],
			"custom": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["px", "em", "rem", "%", "vw", "vh"],
			"customSpacingSize": true,
			"spacingSizes": [
				{ "slug": "xs", "size": "0.5rem", "name": "XS" },
				{ "slug": "sm", "size": "1rem", "name": "S" },
				{ "slug": "md", "size": "2rem", "name": "M" },
				{ "slug": "lg", "size": "4rem", "name": "L" },
				{ "slug": "xl", "size": "6rem", "name": "XL" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "System Sans",
					"slug": "system-sans",
					"fontFamily": "ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'"
				}
			],
			"fontSizes": [
				{ "slug": "xs", "size": "0.75rem", "name": "XS" },
				{ "slug": "sm", "size": "0.875rem", "name": "S" },
				{ "slug": "md", "size": "1rem", "name": "M" },
				{ "slug": "lg", "size": "1.125rem", "name": "L" },
				{ "slug": "xl", "size": "1.25rem", "name": "XL" },
				{ "slug": "2xl", "size": "1.5rem", "name": "2XL" },
				{ "slug": "3xl", "size": "1.875rem", "name": "3XL" },
				{ "slug": "4xl", "size": "2.25rem", "name": "4XL" },
				{ "slug": "heading-1", "size": "3rem", "name": "Heading 1" },
				{ "slug": "heading-2", "size": "1.875rem", "name": "Heading 2" },
				{ "slug": "heading-3", "size": "1.25rem", "name": "Heading 3" }
			],
			"fontWeight": true,
			"lineHeight": true,
			"customFontSize": true,
			"dropCap": true,
			"letterSpacing": true,
			"textTransform": true
		},
		"custom": {
			"mobileLogo": "",
			"spacing": {
				"viewport": "1"
			},
			"breakpoints": {
				"tablet": "768px",
				"small-desktop": "1024px",
				"desktop": "1280px",
				"laptop": "1366px",
				"large-desktop": "1440px",
				"full-hd": "1920px",
				"quad-hd": "2560px"
			},
			"content-size": {
				"desktop": "1152px",
				"wide": "1280px"
			}
		},
		"layout": {
			"contentSize": "1152px",
			"wideSize": "1280px"
		}
	},
	"styles": {
		"color": {
			"background": "#f7f9fb",
			"text": "#1d2531"
		},
		"typography": {
			"fontFamily": "ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'",
			"fontSize": "16px",
			"lineHeight": "1.5",
			"fontWeight": "400"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				}
			}
		}
	},
	"templateParts": []
}
